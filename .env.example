# Configuration for the whole stack (compose.yaml reads this file as .env).
# `make init` copies it and generates local secrets; never commit real values.

APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO

# --- Secrets (required; `make init` generates local values) --------------------
POSTGRES_PASSWORD=
MINIO_ROOT_USER=docintel
MINIO_ROOT_PASSWORD=
JWT_SECRET=                         # >= 32 random characters
METRICS_TOKEN=                      # bearer token for /metrics (required in production)

# --- Web app (frontend) ----------------------------------------------------------
WEB_PORT=3000                       # http://localhost:3000
APP_ORIGIN=http://localhost:3000    # public origin of the web app (CSRF check); change with the port/domain
COOKIE_SECURE=false                 # true when served over HTTPS

# --- API (backend) -----------------------------------------------------------------
API_PORT=8000                       # http://localhost:8000/docs (scripts, curl, OpenAPI)
REGISTRATION_MODE=open              # open (local demo) | disabled (production: admins create users)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- AI providers -------------------------------------------------------------------
# Left empty here: `make init` picks hosted (Mistral) when a key is set, local otherwise.
EXTRACTION_PROVIDER=                # hosted | local
EMBEDDING_PROVIDER=                 # hosted | local
AI_EXTERNAL_TRANSMISSION_ENABLED=   # must be true for hosted
MISTRAL_API_KEY=
# Hosted (OpenAI-compatible; Mistral by default). Requires AI_EXTERNAL_TRANSMISSION_ENABLED=true.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=open-mistral-nemo
# EMBEDDING_MODEL=mistral-embed     # 1024 dimensions (matches the database column)

# --- Original-file storage ------------------------------------------------------------
# s3 = MinIO/S3 (default). uploadthing = raw original files stored in UploadThing
# (derived artifacts still use MinIO/S3). Free UploadThing apps only allow
# public-read files: the URL is unguessable but anyone holding it can read the file.
ORIGINALS_STORAGE=s3
UPLOADTHING_TOKEN=                  # from the UploadThing dashboard (API Keys → token); never commit it
UPLOADTHING_ACL=public-read         # private requires a paid UploadThing plan
UPLOADTHING_ALLOW_PUBLIC_FILES=false  # must be true to use public-read when APP_ENV=production

